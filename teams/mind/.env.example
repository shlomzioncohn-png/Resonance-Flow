# --- Vector store (pgvector, resolved -- see README "Open decisions") ---
# Matches the `vector-store` service in docker-compose.yml (pgvector/
# pgvector image). No API key: Postgres auth is user/password, not a
# key.
VECTOR_STORE_URL=postgresql://mind:mind@vector-store:5432/mind
VECTOR_STORE_USER=mind
VECTOR_STORE_PASSWORD=mind
VECTOR_STORE_DB=mind

# --- Model serving ---
LLM_API_KEY=
LLM_MODEL=
MODEL_CACHE_DIR=./models

# --- OCR / ASR (local models -- see README "Open decisions") ---
# OCR engine: NOT DECIDED -- Tesseract vs. PaddleOCR mobile. On FUNSD (n=2)
# PaddleOCR mobile has ~2.7x fewer character errors (grouped CER 0.074 vs.
# 0.200 for Tesseract --psm 11) at ~90x the latency and ~18x the memory.
# OCR_ENGINE=tesseract below is a placeholder, not a decision; see
# benchmarks/ocr-asr-benchmark.md "OCR -- final decision".
OCR_PROVIDER=local
OCR_ENGINE=tesseract
OCR_TESSERACT_PSM=11
# ASR: KNOWN RISK, not just "open" -- no AMI sample exists anywhere to
# benchmark against, so WHISPER_MODEL below is an unverified guess, not
# a decision. Do not treat it as final. See benchmarks/ocr-asr-benchmark.md
# "Known risk" before relying on this for capacity planning.
# When this does get benchmarked: also test the .en (English-only)
# variant (e.g. base.en) alongside the multilingual one -- MIND's app
# is English-only, and Whisper's .en models are typically more accurate
# than the multilingual model of the same size on English audio. See
# benchmarks/ocr-asr-benchmark.md "Open item".
ASR_PROVIDER=local
WHISPER_MODEL=base

# --- Object storage (Bridge handoff) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Service ---
MIND_API_PORT=8000
LOG_LEVEL=INFO
