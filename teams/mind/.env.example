# Connection settings (vector store, Kafka, object storage, providers) are not
# env vars: MIND reads them only from the file $CONFIG_FILE_PATH names (#481).
# `docker compose up` mounts config.compose.yml for it. A MIND_VECTOR_STORE__DSN
# here is ignored.

# --- Vector store (pgvector; see benchmarks/vector-store-comparison.md) ---
# These configure the `vector-store` container itself. Under Compose, MIND gets
# POSTGRES_PASSWORD from here too (docker-compose.yml's mind-secrets); USER/DB
# must match vector_store.user/.db in config.compose.yml.
POSTGRES_USER=mind
POSTGRES_PASSWORD=mind
POSTGRES_DB=mind

# Tuning knobs, not connection settings -- these still come from env.
# MIND_VECTOR_STORE__TABLE=task_embeddings
# MIND_VECTOR_STORE__SEARCH_EFFORT=200
# MIND_DUPLICATE_SIMILARITY_THRESHOLD=0.90

# --- Model serving ---
# MODEL_CACHE_DIR: if <dir>/bge-small-en-v1.5/ exists, embed() loads it
# with no network call (see models/README.md); else downloads from HF.
MODEL_CACHE_DIR=./models

# --- OCR / ASR (local models) ---
# Tesseract chosen over PaddleOCR on latency/memory -- see benchmarks/ocr-asr-benchmark.md.
# --psm lives in CHOSEN_PSM_ARGS (benchmarks/ocr_asr_benchmark.py), not an env var here.
# ASR: Whisper base.en (faster-whisper, int8, CPU), measured against tiny.en /
# small.en -- see benchmarks/ocr-asr-benchmark.md "ASR -- final decision".
# Must match CHOSEN_WHISPER_SIZE in benchmarks/asr_benchmark.py (a test checks).
# Only a fallback: config.yaml's asr.whisper_model wins when it's set.
WHISPER_MODEL=base.en
# When a model call counts as slow / expensive in GET /debug/model-calls and the
# model_call_summary log line (none = no check), and how often that line is
# logged (0 or none = never). Defaults and their sources: config.MonitoringSettings.
# An invalid value falls back to all the defaults and logs an ERROR at start-up.
# OCR/ASR cost is measured in CPU seconds, not dollars, so only LLM calls have a
# cost limit (in USD).
# MIND_MONITORING__OCR_MAX_DURATION_MS=30000
# MIND_MONITORING__ASR_MAX_DURATION_MS=120000
# MIND_MONITORING__LLM_MAX_DURATION_MS=10000
# MIND_MONITORING__LLM_MAX_COST_USD=0.02
# MIND_MONITORING__SUMMARY_EVERY_N_CALLS=100

# --- Service ---
MIND_ENVIRONMENT=local
MIND_API_PORT=8000
# Only a fallback: config.yaml's service.log_level wins when it's set.
MIND_LOG_LEVEL=INFO
