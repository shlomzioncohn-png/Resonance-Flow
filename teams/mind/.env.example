# --- Vector store (pgvector) ---
# These three are consumed directly by the `vector-store` service in
# docker-compose.yml, and combined into a single DSN there for the `mind`
# service (see MIND_VECTOR_STORE__DSN there) -- .env.example itself never
# lists a DSN because docker-compose builds it for you.
POSTGRES_USER=mind
POSTGRES_PASSWORD=mind
POSTGRES_DB=mind

# MIND_VECTOR_STORE__TABLE=task_embeddings
# MIND_VECTOR_STORE__SEARCH_EFFORT=400
# MIND_VECTOR_STORE__EMBEDDING_DIM=256
# MIND_DUPLICATE_SIMILARITY_THRESHOLD=0.90

# --- Model serving ---
LLM_API_KEY=
LLM_MODEL=
MODEL_CACHE_DIR=./models

# --- OCR / ASR (managed API vs. local — see README "Open decisions") ---
OCR_PROVIDER=local
ASR_PROVIDER=local
WHISPER_MODEL=base

# --- Object storage (Bridge handoff) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Service ---
MIND_ENVIRONMENT=local
MIND_API_PORT=8000
MIND_LOG_LEVEL=INFO
