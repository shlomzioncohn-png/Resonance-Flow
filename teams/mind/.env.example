# --- Vector store (see benchmarks/vector-store-comparison.md for the backend decision) ---
# host=localhost is only correct when running `mind` directly on your
# machine against a locally-running DB. Inside `docker compose up`,
# docker-compose.yml overrides this for the `mind` service to
# host=vector-store (the DB's service name on the compose network) --
# `localhost` inside that container would mean the container itself, not
# the DB container next to it.
MIND_VECTOR_STORE_DSN=dbname=mind user=postgres password=postgres host=localhost port=5432
# MIND_VECTOR_STORE_TABLE=task_embeddings
# MIND_VECTOR_SEARCH_EFFORT=400
# MIND_EMBEDDING_DIM=384
# MIND_DUPLICATE_SIMILARITY_THRESHOLD=0.90

# --- Model serving ---
LLM_API_KEY=
LLM_MODEL=
MODEL_CACHE_DIR=./models

# --- OCR / ASR (managed API vs. local — see README "Open decisions") ---
OCR_PROVIDER=local
ASR_PROVIDER=local
WHISPER_MODEL=base

# --- Object storage (Bridge handoff) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Service ---
MIND_API_PORT=8000
LOG_LEVEL=INFO
