# --- Vector store (pgvector; see benchmarks/vector-store-comparison.md) ---
# MIND_VECTOR_STORE__DSN below is for running outside Docker, against
# `docker compose up vector-store -d`.
POSTGRES_USER=mind
POSTGRES_PASSWORD=mind
POSTGRES_DB=mind
MIND_VECTOR_STORE__DSN=postgresql://mind:mind@localhost:5432/mind

# MIND_VECTOR_STORE__TABLE=task_embeddings
# MIND_VECTOR_STORE__SEARCH_EFFORT=400
# MIND_DUPLICATE_SIMILARITY_THRESHOLD=0.90

# --- Model serving ---
LLM_API_KEY=
LLM_MODEL=
# MODEL_CACHE_DIR: if <dir>/bge-small-en-v1.5/ exists, embed() loads it
# with no network call (see models/README.md); else downloads from HF.
MODEL_CACHE_DIR=./models

# --- OCR / ASR (local models) ---
# Tesseract chosen over PaddleOCR on latency/memory -- see benchmarks/ocr-asr-benchmark.md.
OCR_PROVIDER=local
OCR_ENGINE=tesseract
# --psm lives in CHOSEN_PSM_ARGS (benchmarks/ocr_asr_benchmark.py), not an env var here.
# ASR: Whisper base.en (faster-whisper, int8, CPU), measured against tiny.en /
# small.en -- see benchmarks/ocr-asr-benchmark.md "ASR -- final decision".
# Must match CHOSEN_WHISPER_SIZE in benchmarks/asr_benchmark.py (a test checks).
ASR_PROVIDER=local
WHISPER_MODEL=base.en
# Price of one CPU-hour, turning each OCR/ASR call's measured CPU seconds into
# an estimated USD cost (src/mind/observability/compute.py). Leave unset and
# those costs are recorded as unpriced (None), not as 0. Set it to what the
# machine MIND runs on costs per vCPU-hour.
# MIND_COMPUTE_COST__USD_PER_CPU_HOUR=
# When a model call counts as slow / expensive in GET /debug/model-calls and the
# model_call_summary log line (none = no check), and how often that line is
# logged (0 = never). Defaults and their sources: config.MonitoringSettings.
# MIND_MONITORING__OCR_MAX_DURATION_MS=30000
# MIND_MONITORING__ASR_MAX_DURATION_MS=120000
# MIND_MONITORING__LLM_MAX_DURATION_MS=30000
# MIND_MONITORING__LLM_MAX_COST_USD=0.01
# MIND_MONITORING__SUMMARY_EVERY_N_CALLS=100

# --- Object storage (Bridge handoff) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Service ---
MIND_ENVIRONMENT=local
MIND_API_PORT=8000
MIND_LOG_LEVEL=INFO
