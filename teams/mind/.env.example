# --- Vector store (pgvector, resolved -- see README "Open decisions") ---
# Matches the `vector-store` service in docker-compose.yml (pgvector/
# pgvector image). No API key: Postgres auth is user/password, not a
# key.
VECTOR_STORE_URL=postgresql://mind:mind@vector-store:5432/mind
VECTOR_STORE_USER=mind
VECTOR_STORE_PASSWORD=mind
VECTOR_STORE_DB=mind

# --- Model serving ---
LLM_API_KEY=
LLM_MODEL=
MODEL_CACHE_DIR=./models

# --- OCR / ASR (local models -- see README "Open decisions") ---
# OCR resolved: Tesseract (--psm 11, sparse text), chosen over PaddleOCR on
# latency and memory (~0.5s / ~34MB vs. ~45s / ~600MB per page). A trade made
# knowingly: PaddleOCR mobile has ~2.7x fewer character errors on FUNSD (grouped
# CER 0.074 vs. 0.200) -- see benchmarks/ocr-asr-benchmark.md.
OCR_PROVIDER=local
OCR_ENGINE=tesseract
# The chosen --psm lives in one place, CHOSEN_PSM_ARGS in
# benchmarks/ocr_asr_benchmark.py -- not here: nothing reads an env var for it.
# ASR resolved (#135): Whisper base.en, run with faster-whisper (int8, CPU).
# Measured against tiny.en and small.en on two AMI meetings (63 min of audio),
# two runs: base.en has rough WER ~0.26 at ~10x faster than real time (RTF
# 0.10 typical, up to ~0.3 under load); small.en is 0.9-1.6 points better but
# ~5x slower; tiny.en's rough WER is within noise of base.en's, but its word
# precision is lower in both runs. Peak memory ~2GB for all three. n=2
# meetings and a rough word diff, not a real WER -- see
# benchmarks/ocr-asr-benchmark.md "ASR -- known risks".
# Must match CHOSEN_WHISPER_SIZE in benchmarks/asr_benchmark.py (a test checks).
ASR_PROVIDER=local
WHISPER_MODEL=base.en

# --- Object storage (Bridge handoff) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Service ---
MIND_API_PORT=8000
LOG_LEVEL=INFO
