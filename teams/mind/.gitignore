# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Generated from proto/*.proto by `make proto` — never commit
src/mind/messaging/*_pb2.py
src/mind/messaging/*_pb2.pyi

# Local model weights — never commit
models/*
!models/.gitkeep
!models/README.md

# Env / secrets
.env
.env.local
# Local stand-ins for the config.yaml/secrets.yaml the Helm chart mounts
# in the cluster. They hold real provider keys -- never commit them.
*.local.yaml

# OS / editor
.DS_Store
.vscode/
!.vscode/extensions.json

# Personal AI-assistant notes — local only, never shared via git
CLAUDE.md

# Local-only Docker build workaround for this machine's network TLS
# interception (NetFree). Machine-specific, never shared -- the real
# Dockerfile that ships to Relay/CI is untouched.
netfree-root-ca.crt
Dockerfile.local
docker-compose.override.yml

# Benchmark run artifacts (keep READMEs, not raw dumps)
benchmarks/**/*.json
benchmarks/**/*.csv
!benchmarks/README.md
# threshold_calibration_tasks.json is input data (the task pool), not a
# results dump -- must be tracked or the script isn't reproducible.
!benchmarks/threshold_calibration_tasks.json

# Datasets — manifests/checksums only, never the corpora
eval/datasets/*
!eval/datasets/.gitkeep
!eval/datasets/README.md
!eval/datasets/*.manifest.json
!eval/datasets/*.sha256

# Harness run output (mind.evaluation.run writes report.json to the cwd;
# mind.evaluation.run_extraction_eval writes extraction_report.json)
report.json
extraction_report.json

# Local raw datasets — never commit
local-data/

# Claude Code session tooling, including any worktree it creates --
# never project content, must never be committed.
.claude/
skills-lock.json
