{
  "uid": "resonance-flow-system-overview",
  "title": "Resonance-Flow / System overview",
  "description": "Health of every component in the resonance-flow namespace, Kafka lag and the infra subcharts (Kafka, PostgreSQL, MinIO). Per-team dashboards live in each team's folder.",
  "tags": ["resonance-flow", "overview"],
  "timezone": "utc",
  "editable": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "title": "Platform alerts",
      "type": "link",
      "icon": "bell",
      "url": "/d/resonance-flow-platform-alerts"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "query": "resonance-flow",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Components",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Workloads ready",
      "description": "Ready / desired replicas per Deployment (components) and StatefulSet (Kafka, PostgreSQL, MinIO).",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"$namespace\"}) / sum by (deployment) (kube_deployment_spec_replicas{namespace=\"$namespace\"})",
          "legendFormat": "{{deployment}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (statefulset) (kube_statefulset_status_replicas_ready{namespace=\"$namespace\"}) / sum by (statefulset) (kube_statefulset_replicas{namespace=\"$namespace\"})",
          "legendFormat": "{{statefulset}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "special", "options": { "match": "nan", "result": { "text": "scaled to 0", "color": "text", "index": 0 } } }
          ]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape targets",
      "description": "Every target Prometheus scrapes in the namespace, by its component label (components with metrics.enabled, plus the infra exporters).",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (component) (up{namespace=\"$namespace\", component!=\"\"})",
          "legendFormat": "{{component}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "index": 0 },
                "1": { "text": "Up", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container restarts (per hour)",
      "description": "Restarts over the trailing hour, per container. Only containers that restarted are shown.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])) > 0",
          "legendFormat": "{{container}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80 } },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU by container",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{container}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cores", "min": 0 }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory by container (working set)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{container}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Broker",
      "description": "The broker's JMX target (KafkaBrokerDown).",
      "gridPos": { "x": 0, "y": 23, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{namespace=\"$namespace\", component=\"kafka\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "index": 0 }, "1": { "text": "Up", "index": 1 } } }]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Offline partitions",
      "gridPos": { "x": 4, "y": 23, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka_controller_kafkacontroller_offlinepartitionscount_value{namespace=\"$namespace\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Messages behind, per consumer group and topic (kafka-exporter). bridge.structured.tasks alerts as BridgeTasksConsumerLagHigh.",
      "gridPos": { "x": 8, "y": 23, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{namespace=\"$namespace\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Produced messages / s by topic",
      "gridPos": { "x": 0, "y": 27, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{namespace=\"$namespace\", topic!~\"__.*\"}[5m]))",
          "legendFormat": "{{topic}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Infra",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "PostgreSQL",
      "gridPos": { "x": 0, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_up{namespace=\"$namespace\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "index": 0 }, "1": { "text": "Up", "index": 1 } } }]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "MinIO nodes online",
      "gridPos": { "x": 4, "y": 32, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(minio_cluster_nodes_online_total{namespace=\"$namespace\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "PostgreSQL connections by database",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{namespace=\"$namespace\", datname!~\"template.*\"})",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Volume usage",
      "description": "Used / capacity per PVC. Empty until postgresql/minio persistence is on.",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\"})",
          "legendFormat": "{{persistentvolumeclaim}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.85 }] },
          "noValue": "no PVCs"
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "MinIO usage by bucket",
      "gridPos": { "x": 0, "y": 36, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (bucket) (minio_bucket_usage_total_bytes{namespace=\"$namespace\"})",
          "legendFormat": "{{bucket}}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "noValue": "no buckets" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
