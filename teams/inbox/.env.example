SERVER_PORT=8080

SPRING_PROFILES_ACTIVE=local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=resonance_flow
DB_USER=postgres
DB_PASSWORD=postgres
KAFKA_PORT=9092

KAFKA_UI_PORT=8090

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Apicurio Schema Registry, ccompat (Confluent-compatible) API - required suffix, see
# teams/relay/docs/kafka-producer-consumer-guide.md. No local container provides this yet
# (see docker-compose.yml known gap); task.created/updated/completed publish will fail without
# a reachable one.
SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v6

KAFKA_CONSUMER_GROUP_ID=inbox-service

BRIDGE_STRUCTURED_TASKS_TOPIC=bridge.structured.tasks
CHAIN_SCHEDULING_UPDATED_TOPIC=task.scheduling.updated
MIND_TASK_CREATION_REQUESTED_TOPIC=task.creation.requested

INBOX_KAFKA_RETRY_MAX_ATTEMPTS=3
INBOX_KAFKA_RETRY_INITIAL_BACKOFF_MS=500
INBOX_KAFKA_RETRY_MULTIPLIER=2.0
INBOX_KAFKA_RETRY_MAX_BACKOFF_MS=10000

