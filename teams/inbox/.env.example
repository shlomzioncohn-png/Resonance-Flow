# Copy this file to .env and adjust as needed. Do not commit the real .env file.

# Port the Inbox service listens on
SERVER_PORT=8080

# Active Spring profile
SPRING_PROFILES_ACTIVE=local

# Port Kafka listens on (host-facing)
KAFKA_PORT=9092

# Port Kafka UI is served on
KAFKA_UI_PORT=8090

# NOTE: no database variables yet - DB choice for the project has not been decided.
# Once it is, connection settings (URL/user/password) will be added here.
