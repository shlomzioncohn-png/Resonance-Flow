<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Spring Boot's own defaults: console + the main log file, driven by application.yml. -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <property name="SQL_LOG_FILE" value="${SQL_LOG_FILE_PATH:-logs/inbox-sql.log}"/>

    <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SQL_LOG_FILE}</file>
        <!-- One JSON object per line; see SqlLogJsonEncoder for the fields. -->
        <encoder class="com.rnd.inbox.shared.logging.SqlLogJsonEncoder"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SQL_LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-10MB}</maxFileSize>
            <maxHistory>${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-14}</maxHistory>
            <totalSizeCap>${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-500MB}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- additivity="false": SQL lines go to their own file only, not to the console or inbox.log. -->
    <logger name="com.rnd.inbox.shared.logging.SqlQueryLoggingListener" additivity="false">
        <appender-ref ref="SQL_FILE"/>
    </logger>

</configuration>
