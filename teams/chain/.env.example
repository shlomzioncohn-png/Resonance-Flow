# Copy this file to .env and adjust as needed. Do not commit the real .env file.

# Port the Chain service listens on
SERVER_PORT=8081

# Active Spring profile
SPRING_PROFILES_ACTIVE=local

# Kafka broker(s) Chain connects to. Defaults to localhost:9092, which only
# works when Kafka runs on the same host network as this container - point
# this at a real broker (or a sibling docker-compose service) otherwise.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Postgres connection (issue #378) - Chain's own dedicated database/user, not Inbox's
# resonance_flow. Values below are placeholders pending DevOps provisioning the real DB/user
# (see teams/chain/CLAUDE.md) - update once that lands.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chain
DB_USER=chain_user
DB_PASSWORD=chain_password
