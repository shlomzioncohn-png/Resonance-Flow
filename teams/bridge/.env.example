# Copy this file to .env and adjust as needed. Do not commit the real .env file.

# Port the Bridge service listens on
SERVER_PORT=8080

# Active Spring profile
SPRING_PROFILES_ACTIVE=local

# Unstructured-intake lane (Malki) - local MinIO + Redpanda, started via
# `docker compose up -d minio redpanda`. Defaults below match that compose setup, so this
# section only needs editing if you're pointing at a different MinIO/Kafka instance.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bridge-raw
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BRIDGE_RAW_LANDED_TOPIC=bridge.raw.landed

# Meeting/doc/audio hand-off (Esther) - local folders to upload during manual test intake,
# one per source. Personal to your machine - point these at wherever you keep sample files.
# Shares the MinIO/Kafka settings above with the Unstructured-intake lane.
BRIDGE_MEDIA_ZOOM_RECORDINGS_DIR=
BRIDGE_MEDIA_BBB_RECORDINGS_DIR=
BRIDGE_MEDIA_SCANNED_DOCS_DIR=
BRIDGE_MEDIA_TENANT_ID=demo-tenant
BRIDGE_MEDIA_MIN_FILE_SIZE_BYTES=1024

# CRM lane (Ruth) - the Inbox tenant every deal-derived task belongs to.
# Required, no default: startup fails loudly if unset (see
# bridge.crm.organization-id in application.yml / CrmLaneConfig). Inbox's
# tenants.id is gen_random_uuid() (table renamed from organizations, V7
# migration, 2026-09-06), so this is a real UUID that differs per environment
# - Ayala (Inbox) still needs to create the tenant record and hand back the
# value for each of dev/staging/prod. Placeholder below is not a real id -
# replace per environment once Ayala provides one.
# The var/property name itself deliberately still says "organization", not
# "tenant" - renaming it touches Helm, every deployed environment's config,
# and local run configurations, for zero correctness gain (this is a label,
# not a wire field). See teams/bridge/CLAUDE.md §6 for this and the matching
# Task.organizationId decision, tracked together.
CRM_ORGANIZATION_ID=REPLACE_WITH_ORG_UUID_FROM_AYALA_FOR_THIS_ENVIRONMENT

# CRM lane (Ruth) - days an open deal may sit in the same stage before earning a +1 urgency bump; <= 0 disables it.
CRM_STALLED_AFTER_DAYS=14

# NOTE: the GitHub Bridge lane hasn't wired its infra yet.
# Daily CRM sync (Ruth) - off by default; set to true to enable the
# scheduled HubSpot to Kafka pull (see bridge.crm.sync.cron in application.yml).
CRM_SYNC_CRON_ENABLED=false

# Salesforce CRM source (Ruth) - only used with SPRING_PROFILES_ACTIVE including "salesforce".
# OAuth 2.0 Client Credentials Flow against an External Client App / Connected App - see
# teams/bridge/docs/crm-salesforce-design.md §1 for org setup. No Salesforce org exists for this
# work yet (design doc §9) - these have no real value to put here until one is provisioned.
SALESFORCE_LOGIN_URL=https://REPLACE_WITH_MY_DOMAIN.my.salesforce.com
SALESFORCE_CLIENT_ID=REPLACE_WITH_CONSUMER_KEY
SALESFORCE_CLIENT_SECRET=REPLACE_WITH_CONSUMER_SECRET
# REST API version - not a secret, so a working default (the current release as of this writing)
# is fine here. Bump it as Salesforce retires old versions (see application-salesforce.yml).
SALESFORCE_API_VERSION=68.0
# Opportunity field read as the deal's stageChangedAt - switch to LastModifiedDate if
# LastStageChangeDate doesn't exist on the target org (unverified - see application-salesforce.yml).
SALESFORCE_STAGE_CHANGED_AT_FIELD=LastStageChangeDate
# Full stage-history read - not implemented yet, leave false (see application-salesforce.yml).
SALESFORCE_LOAD_HISTORY=false

# NOTE: the other 3 Bridge lanes (GitHub, CRM, meeting/doc/audio) haven't wired their infra yet.
