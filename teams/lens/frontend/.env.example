# Base URL of the LENS Gateway (see teams/lens/gateway/GATEWAY_CONTRACT.md).
# The frontend calls only the Gateway — never BFF or any other team's service directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to "enabled" to answer, with MSW in the browser (mocks/handlers.ts), the Manager's Users
# screen (/api/manager/users - works without Gateway/BFF/Inbox running), sign-in and sign-out
# (POST /auth/login, /auth/logout - accounts manager1@lens.test / manager1 and
# employee1@lens.test / employee1) and GET /api/manager/bottlenecks/graph (the Gateway doesn't
# expose that yet). Every other call still goes to the Gateway. Leave empty to call the Gateway
# for everything.
NEXT_PUBLIC_API_MOCKING=
