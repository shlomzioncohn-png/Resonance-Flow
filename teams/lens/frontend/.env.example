# Base URL of the LENS Gateway (see teams/lens/gateway/GATEWAY_CONTRACT.md).
# The frontend calls only the Gateway — never BFF or any other team's service directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to "enabled" to answer the Manager's Users screen (/api/manager/users) with MSW in
# the browser (mocks/handlers.ts), so it works without Gateway/BFF/Inbox running. Every
# other call still goes to the Gateway. Leave empty to call the Gateway for everything.
NEXT_PUBLIC_API_MOCKING=
