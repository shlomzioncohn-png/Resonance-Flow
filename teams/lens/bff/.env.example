# LENS BFF Environment Configuration
# Copy this file to .env and adjust values for your environment

# Server Configuration
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=local

# Inbox Service Configuration
# URL where Inbox service is running
INBOX_SERVICE_URL=http://localhost:8081

# Inbox Service Account Configuration
# Service account UUID used to authenticate BFF requests to Inbox
# Must match the service account created in Inbox seed
INBOX_SERVICE_ACCOUNT_ID=00000000-0000-0000-0000-000000000002

# Inbox HTTP Client Configuration
INBOX_SERVICE_CONNECT_TIMEOUT_MS=5000
INBOX_SERVICE_READ_TIMEOUT_MS=10000

# Spring Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
