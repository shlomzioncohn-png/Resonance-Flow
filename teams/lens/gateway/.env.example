# LENS Gateway Environment Configuration
# Copy this file to .env and adjust values for your environment

# Server Configuration
GATEWAY_PORT=8080
BFF_PORT=8082
SPRING_PROFILES_ACTIVE=local

# BFF Service Configuration
# URL where BFF service is running (default: the BFF started from teams/lens/bff, on the host)
BFF_SERVICE_URL=http://host.docker.internal:8082

# Connection and read timeouts (milliseconds)
BFF_CONNECT_TIMEOUT_MS=2000
BFF_READ_TIMEOUT_MS=10000

# BFF Endpoint Paths
# These can be changed if BFF renames or restructures its routes
BFF_ENDPOINT_WORKSPACE_RECOMMEND=/workspace/recommend
BFF_ENDPOINT_TASKS=/workspace/tasks
