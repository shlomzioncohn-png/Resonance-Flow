# Resonance Flow - Multi-Service Configuration
# Copy this file to .env and customize as needed. Do not commit the real .env file.

# LENS - host ports (Gateway is not on 8080: that is Bridge's)
GATEWAY_PORT=8086
BFF_PORT=8087
FRONTEND_PORT=3000
STORYBOOK_PORT=6006

# LENS BFF -> Inbox. true = the BFF's in-memory mock tasks, no Inbox needed.
INBOX_MOCK_ENABLED=false
# Seeded Inbox user the BFF sends as X-Actor-Id (needs Inbox's seed loaded - see
# teams/lens/frontend/docs/api-integration-status.md, "Running locally")
INBOX_DEV_ACTOR_ID=ef071a8a-1040-3a27-904a-f6352bad4fea

# Spring Profile (local = no auth, prod = requires auth)
# local: Disables security, allows all requests
# prod: Enables Spring Security, requires authentication
SPRING_PROFILES_ACTIVE=local

# Shared PostgreSQL instance; bridge uses DB_NAME/DB_USER/DB_PASSWORD directly
DB_NAME=resonance_flow
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Chain owns its own database + DB user on the same Postgres instance above, created by
# shared/database/init/create-chain-database.sh on first startup - see PR #417.
CHAIN_DB_PASSWORD=chain

# Same for inbox, created by shared/database/init/create-inbox-database.sh - see issue #869.
# An existing local volume predates it: run `docker compose down -v` once to recreate it.
INBOX_DB_PASSWORD=inbox

# Backend team service ports (host side; container port is always 8080,
# except chain which listens on 8081 internally too)
CHAIN_SERVER_PORT=8081
BRIDGE_SERVER_PORT=8080
INBOX_SERVER_PORT=8082

# pgAdmin (Postgres UI) - http://localhost:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Not yet wired into docker-compose.yml - placeholders for when these land:
# MIND_PORT=8085
# Gateway Service URLs (container internal network), once BFF/gateway route to them:
# BRIDGE_URL=http://bridge-service:8080
# MIND_URL=http://mind-service:8080
# INBOX_URL=http://inbox-service:8080
# CHAIN_URL=http://chain-service:8081
