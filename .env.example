# Copy this file to .env and adjust as needed. Do not commit the real .env file.

# Shared PostgreSQL (used by chain, bridge, inbox)
DB_NAME=resonance_flow
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Team service ports
CHAIN_SERVER_PORT=8081
BRIDGE_SERVER_PORT=8080
INBOX_SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=local

# pgAdmin (Postgres UI) - http://localhost:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
