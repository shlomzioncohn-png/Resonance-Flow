# Resonance Flow - Multi-Service Configuration
# Copy this file to .env and customize as needed

# API Gateway Configuration
GATEWAY_PORT=8080

# Service Ports (mapped from containers to host)
# Internal container port is always 8080
BRIDGE_PORT=8081
MIND_PORT=8082
INBOX_PORT=8083
CHAIN_PORT=8084

# Spring Profile (local = no auth, prod = requires auth)
# local: Disables security, allows all requests
# prod: Enables Spring Security, requires authentication
SPRING_PROFILES_ACTIVE=local

# Gateway Service URLs (container internal network)
# These are automatically passed to gateway via docker-compose
# Override only if using custom network names
# BRIDGE_URL=http://bridge-service:8080
# MIND_URL=http://mind-service:8080
# INBOX_URL=http://inbox-service:8080
# CHAIN_URL=http://chain-service:8080
